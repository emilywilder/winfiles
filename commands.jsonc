// winfiles' commands, run with winfiles.ps1 (`./winfiles.ps1 <command> [arguments]`). The runner is in
// scripts/commands.ps1; this file is data only, so a later runner in another language can read it as it is.
//
// Each command has:
//   description  the line `winfiles.ps1` lists (none for a private command)
//   parameters   [{ "name", "default" }], given in order on the command line; a parameter without a default is
//                required. Defaults may use {computername} (lowercased), {username} and {home}
//   passArgs     true: every argument after the parameters goes on to the script, after its args
//   requires     files that must exist before anything runs, for the whole plan: checked before any UAC prompt
//   dependsOn    commands run first, as "<name> <argument>...", with {parameter} placeholders
//   steps        commands that make up this one, run in order under its privilege
//   script       a script run as `pwsh -NoLogo -NoProfile -File <script> <args>`, after the steps
//   args         the script's arguments, with {parameter} placeholders
//   pwshArgs     options for that pwsh before -File, such as -NoExit
//   builtin      a command the runner does itself (hosts, help)
//   privilege    admin (elevates once, through scripts/Invoke-AsAdmin.ps1, unless the shell already is), user
//                (through scripts/Invoke-AsUser.ps1), or any (the default: runs as it is)
//   uacMessage   printed before the UAC prompt, when there is one
//   log          { "phase", "started", "finished" }: lines in run.log; finished only when everything passed
//   clean        true: the run goes through scripts/Invoke-Clean.ps1 first, once (docs/run/clean-environment.md)
//   resumable    true: a run that stops for a restart continues at the next sign-in with this command's arguments
//                (docs/run/resume.md). The run clears an entry an earlier one left, and puts the arguments in
//                WINFILES_RESUME for scripts/restart.ps1 to arm
//   private      true: not listed, and only run as a step or dependency
//   group        the heading it's listed under
// A command that appears twice in a plan with the same arguments runs once.
{
    // A configuration is picked by host and user, like nixosConfigurations.<host> and
    // homeConfigurations."<user>@<host>".
    // system, home, check and install run scripts/Invoke-Configuration.ps1, which flattens the documents it is given
    // (scripts/ConvertTo-FlatConfiguration.ps1, docs/run/flat-configuration.md) and splits the result into batches
    // by privilege. The documents themselves still run under dsc directly:
    // `./winfiles.ps1 dsc config test --file dsc/iris.system.dsc.yaml`

    // Each step skips what's already done, so this can be rerun at any point.
    // The system and home configurations are one aggregate: what needs a restart (the resources report it to DSC) is
    // applied first, and while Windows has a restart pending (after enabling optional features, say), configure
    // exits with 3010 and stops here, so a clean install runs this twice, before and after the restart (which
    // configure starts itself when this run made it pending). The steps all run under one elevation, so each run
    // asks for UAC once, at the start, after the configurations have been found. The batches of the home
    // configuration drop back to unelevated for themselves, since Scoop's installer refuses elevation. From an
    // already elevated shell there is no prompt.
    // A package that fails doesn't stop the rest, so check comes after them: its exit code is what reports the
    // failure. post-install only runs once check has passed. An exit code of 3010 comes out unchanged, and
    // scripts/restart.ps1 has armed the resume by then.
    "install": {
        "description": "set up a clean Windows 11 install as a host's configurations describe (either shell; rerun after its restart)",
        "parameters": [{ "name": "host", "default": "{computername}" }, { "name": "user", "default": "{username}" }],
        "requires": ["dsc/{host}.system.dsc.yaml", "dsc/{user}@{host}.home.dsc.yaml"],
        "steps": ["configure {host} {user}", "check {host} {user}", "post-install {host} {user}"],
        "privilege": "admin",
        "uacMessage": "Asking for UAC once, for the whole install: the Windows features in dsc/hosts/{host}/features.dsc.yaml, WSL, the computer name, the system configuration, and then the home one, which runs unelevated",
        "log": {
            "phase": "install",
            "started": "started for host {host}: system, then home, then check",
            "finished": "finished for host {host}: system, home and check all passed"
        },
        "clean": true,
        "resumable": true
    },

    // What the RunOnce entry runs at the sign-in after an install stopped for a restart (scripts/resume.ps1 writes it,
    // docs/run/resume.md): wait for Enter and the network, then install again, which finds what was done to be done.
    // The arguments are install's, with the defaults already filled in
    "resume": {
        "description": "continue an install after its restart: wait for Enter and the network, then run install (what the sign-in entry runs)",
        "parameters": [{ "name": "host", "default": "{computername}" }, { "name": "user", "default": "{username}" }],
        "steps": ["wait-resume", "install {host} {user}"],
        "log": {
            "phase": "resume",
            "started": "resumed after sign-in: install {host} {user}",
            "finished": "the install finished"
        },
        "clean": true
    },

    "wait-resume": {
        "private": true,
        "script": "scripts/Wait-Resume.ps1",
        "clean": true
    },

    // The system and home configurations as one aggregate, in batches. Exits 3010 when a restart is pending, as
    // system does
    "configure": {
        "private": true,
        "parameters": [{ "name": "host" }, { "name": "user" }],
        "script": "scripts/Invoke-Configuration.ps1",
        "args": ["set", "dsc/{host}.system.dsc.yaml", "dsc/{user}@{host}.home.dsc.yaml"],
        "clean": true
    },

    // scripts/Invoke-Configuration.ps1 tests dsc/<host>.system.dsc.yaml to see what needs a restart (the optional
    // features, WSL and the computer's name report it to DSC themselves), applies what reported one first, and
    // restarts once, before anything installs, if Windows then has one pending: installers refuse to run while it
    // is. It exits 3010 then, and install.cmd continues after the restart. Then it applies the rest
    // (docs/run/restarts.md). A failure is reported by Set-Winfiles.ps1, which names the document.
    "system": {
        "description": "apply a host's system configuration (elevates unless already elevated; exits 3010 while a restart is pending)",
        "parameters": [{ "name": "host", "default": "{computername}" }],
        "requires": ["dsc/{host}.system.dsc.yaml"],
        "script": "scripts/Invoke-Configuration.ps1",
        "args": ["set", "dsc/{host}.system.dsc.yaml"],
        "privilege": "admin",
        "uacMessage": "Asking for UAC once, for the elevated steps: the Windows features in dsc/hosts/{host}/features.dsc.yaml, WSL, the computer name, and the rest of dsc/{host}.system.dsc.yaml",
        "clean": true
    },

    // Every batch is unelevated: Scoop's installer refuses an elevated shell. Invoke-Configuration.ps1 runs them
    // through Invoke-AsUser.ps1, as they are from an unelevated shell, and through `gsudo -i Medium` from an
    // elevated one, so this works from either
    "home": {
        "description": "apply a user's home configuration on a host (runs unelevated, from either kind of shell)",
        "parameters": [{ "name": "user", "default": "{username}" }, { "name": "host", "default": "{computername}" }],
        "requires": ["dsc/{user}@{host}.home.dsc.yaml"],
        "script": "scripts/Invoke-Configuration.ps1",
        "args": ["set", "dsc/{user}@{host}.home.dsc.yaml"],
        "clean": true
    },

    // The features need elevation even for get, so this elevates too (once, from an unelevated shell; an install
    // is elevated by now). See dsc/hosts/<host>/features.dsc.yaml
    "check": {
        "description": "test a host's system and home configurations (lists what's missing; exits 1 if anything is)",
        "parameters": [{ "name": "host", "default": "{computername}" }, { "name": "user", "default": "{username}" }],
        "requires": ["dsc/{host}.system.dsc.yaml", "dsc/{user}@{host}.home.dsc.yaml"],
        "script": "scripts/Invoke-Configuration.ps1",
        "args": ["test", "dsc/{host}.system.dsc.yaml", "dsc/{user}@{host}.home.dsc.yaml"],
        "privilege": "admin",
        "uacMessage": "Asking for UAC once, for the elevated half of the check: the Windows features, WSL, the computer name and the system configuration",
        "clean": true
    },

    // Outside DSC, so check keeps meaning "what winfiles can apply by itself". See dsc/hosts/<host>/manual.yaml
    "manual": {
        "description": "download the installers of what a host installs by hand and is missing (never runs them)",
        "parameters": [{ "name": "host", "default": "{computername}" }],
        "requires": ["dsc/{host}.system.dsc.yaml"],
        "script": "scripts/Get-ManualInstaller.ps1",
        "args": ["dsc/hosts/{host}/manual.yaml"],
        "clean": true
    },

    // Prints the `# post-install:` comments in the host's manual.yaml, its two entries and every document they
    // include, modules too
    "post-install": {
        "description": "show what a host and its user still need done by hand after an install",
        "parameters": [{ "name": "host", "default": "{computername}" }, { "name": "user", "default": "{username}" }],
        "requires": ["dsc/{host}.system.dsc.yaml"],
        "script": "scripts/Show-PostInstall.ps1",
        "args": ["dsc/hosts/{host}/manual.yaml", "dsc/{host}.system.dsc.yaml", "dsc/{user}@{host}.home.dsc.yaml"],
        "clean": true
    },

    // Reads installed manifests without running Scoop. Not part of install: most notes are optional, and printing
    // them on every run would bury the post-install ones
    "scoop-notes": {
        "description": "show the notes Scoop's installed apps suggest acting on (registry imports, profile hooks), for review",
        "script": "scripts/Show-ScoopNote.ps1",
        "clean": true
    },

    "hosts": {
        "description": "list the system and home configurations in this repo",
        "builtin": "hosts"
    },

    // Rerun from another checkout to point it there. Doesn't touch PATH: the pwsh profile owns it
    "install-rebuild": {
        "description": "write winfiles-rebuild, which runs this checkout's commands from any directory (default: ~/bin)",
        "parameters": [{ "name": "dir", "default": "{home}/bin" }],
        "script": "scripts/Install-Rebuild.ps1",
        "args": ["{dir}"]
    },

    // A command with passArgs passes its extra arguments on to a script, so Get-Help shows that script's
    // parameters too
    "help": {
        "description": "show a command's arguments and defaults, and the help of the script its extra arguments go to (e.g. help test-vm)",
        "parameters": [{ "name": "command" }],
        "builtin": "help"
    },

    // Resources run against fakes in tests/fakes, so this changes nothing on the machine and needs no VM
    "test": {
        "description": "run the Pester tests (unelevated; e.g. test tests/resources/wingetpackage.Tests.ps1)",
        "group": "test",
        "script": "scripts/Invoke-Test.ps1",
        "passArgs": true,
        "clean": true
    },

    // The rules are in PSScriptAnalyzerSettings.psd1, and the exceptions in docs/dev/style.md
    "lint": {
        "description": "check the PowerShell against the PoshCode style guide with PSScriptAnalyzer (e.g. lint scripts/Invoke-Dsc.ps1)",
        "group": "test",
        "script": "scripts/Invoke-Lint.ps1",
        "passArgs": true,
        "clean": true
    },

    // Windows Sandbox can't run WSL2, so a clean install is tested in a Hyper-V VM with nested virtualization
    "test-vm": {
        "description": "create a Hyper-V test VM from a Windows 11 ISO (elevates; skips if the VM exists)",
        "group": "test",
        "parameters": [{ "name": "iso" }],
        "script": "scripts/New-TestVm.ps1",
        "args": ["-IsoPath", "{iso}"],
        "passArgs": true,
        "privilege": "admin"
    },

    // Copied over PowerShell Direct, so the VM needs no share or git. Replaces ~\src\winfiles in the VM
    "test-vm-copy": {
        "description": "copy this repo's working tree into a running test VM (elevates; -Ref <commit> packs a commit instead)",
        "group": "test",
        "parameters": [{ "name": "name", "default": "winfiles-test" }],
        "script": "scripts/Copy-RepoToTestVm.ps1",
        "args": ["-Name", "{name}"],
        "passArgs": true,
        "privilege": "admin"
    },

    // Elevated in the VM with no UAC, so for checks, not for the bootstrap
    "test-vm-shell": {
        "description": "open a PowerShell Direct session in a running test VM (elevates)",
        "group": "test",
        "parameters": [{ "name": "name", "default": "winfiles-test" }],
        "script": "scripts/Enter-TestVm.ps1",
        "args": ["-Name", "{name}"],
        "pwshArgs": ["-NoExit"],
        "privilege": "admin"
    },

    // E.g. test-vm-run winfiles-test 'wsl -d NixOS -- uname -a'
    "test-vm-run": {
        "description": "run a command in a running test VM, in ~\\src\\winfiles (elevates)",
        "group": "test",
        "parameters": [{ "name": "name" }, { "name": "command" }],
        "script": "scripts/Enter-TestVm.ps1",
        "args": ["-Name", "{name}", "-Command", "{command}"],
        "privilege": "admin"
    },

    // Through a scheduled task in the VM, so a UAC prompt still shows on the VM's desktop and the resume after a
    // restart still needs a sign-in and Enter there (exits 3010 when the command restarts the VM). Windows
    // PowerShell 5.1 runs the command. E.g. test-vm-unelevated winfiles-test '.\install.cmd vm-quick'
    "test-vm-unelevated": {
        "description": "run a command in a running test VM without elevation, as bootstrap.cmd and install.cmd need (elevates here)",
        "group": "test",
        "parameters": [{ "name": "name" }, { "name": "command" }],
        "script": "scripts/Enter-TestVm.ps1",
        "args": ["-Name", "{name}", "-Unelevated", "-Command", "{command}"],
        "privilege": "admin"
    },

    "test-vm-log": {
        "description": "follow a test VM's run.log across restarts; -All adds winget's and installers' logs (elevates; -Tail <lines>)",
        "group": "test",
        "parameters": [{ "name": "name", "default": "winfiles-test" }],
        "script": "scripts/Watch-TestVmLog.ps1",
        "args": ["-Name", "{name}"],
        "passArgs": true,
        "privilege": "admin"
    },

    // E.g. dsc config test --file dsc/iris.system.dsc.yaml. Not clean: it's for working on a configuration by hand
    "dsc": {
        "description": "run dsc (from mise.toml) with discovery limited to DSC, App Installer and dsc/resources",
        "group": "dsc",
        "script": "scripts/Invoke-Dsc.ps1",
        "passArgs": true
    },

    // Writes where system, home and check do, so `dsc config test --file <the printed path>` runs what they run.
    // E.g. flatten dsc/iris.system.dsc.yaml
    "flatten": {
        "description": "write a document's flat copy, with its Includes replaced by their resources, and print its path",
        "group": "dsc",
        "script": "scripts/ConvertTo-FlatConfiguration.ps1",
        "passArgs": true,
        "clean": true
    },

    "dsc-export": {
        "description": "export every exportable DSC resource to YAML (default: ./exports)",
        "group": "dsc",
        "script": "scripts/Export-DscResource.ps1",
        "passArgs": true
    }
}
